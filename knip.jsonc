{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    "apps/api": {
      "project": ["src/**/*.ts"],
    },
    "apps/web": {},
  },
  // The POSIX shell the casino.sh tests run in (T50); /bin/sh on Ubuntu.
  "ignoreBinaries": ["dash"],
  "ignoreDependencies": [
    // `cloudflare:workers` is provided by the Workers runtime.
    "cloudflare",
  ],
}
