{
  "name": "agent-casino",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "check": "biome check . && knip && pnpm typecheck && pnpm typecheck:web && pnpm test",
    "typecheck": "tsc -p apps/api",
    "typecheck:web": "tsc -p apps/web",
    "test": "vitest run",
    "test:api": "vitest run apps/api/src/app apps/api/src/auth apps/api/src/routes apps/api/src/db apps/api/src/room apps/api/src/matchmaker",
    "test:skill": "vitest run apps/api/src/skill",
    "test:web": "pnpm --filter @agent-casino/web test",
    "dev:api": "pnpm --filter @agent-casino/api dev",
    "dev:web": "pnpm --filter @agent-casino/web dev",
    "format": "biome check --write .",
    "test:fuzz": "FUZZ_HANDS=10000 vitest run apps/api/src/holdem/fuzz.test.ts",
    "holdem:play": "node apps/api/scripts/holdem-play.ts",
    "db:generate": "pnpm --filter @agent-casino/api db:generate",
    "db:migrate:local": "pnpm --filter @agent-casino/api db:migrate:local"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "knip": "^6.37.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.135.0"
  }
}
