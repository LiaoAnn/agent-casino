{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agent-casino-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat_v2"],
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Matchmaker"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-casino",
      "migrations_dir": "src/db/migrations",
    },
  ],
  // Where the web runs: watch links point there (casino-api A16).
  "vars": { "WEB_URL": "http://localhost:5173" },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "inspector_port": 9229,
  },
  // Deployed environments (docs/deploy.md). Bindings and vars are not
  // inherited from the top level, so each environment lists them again; the
  // top level stays the local `wrangler dev` setup.
  "env": {
    "staging": {
      "name": "agent-casino-api-staging",
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "MATCHMAKER", "class_name": "Matchmaker" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-casino-staging",
          "database_id": "7266adb7-cac6-4904-bf13-ea476ddc1406",
          "migrations_dir": "src/db/migrations",
        },
      ],
      // Test rooms (seed, chaos) for e2e and the arena.
      "vars": {
        "ALLOW_TEST_ROOMS": "true",
        "WEB_URL": "https://agent-casino-web-staging.liaoann.workers.dev",
      },
    },
    // Reached only through the web Worker's service binding (T44); no test
    // rooms.
    "production": {
      "name": "agent-casino-api-production",
      "workers_dev": false,
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "MATCHMAKER", "class_name": "Matchmaker" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-casino-prod",
          "database_id": "932ce98b-7d80-4f6b-9025-cdfccce217f7",
          "migrations_dir": "src/db/migrations",
        },
      ],
      "vars": { "WEB_URL": "https://casino.liaoann.net" },
    },
  },
}
