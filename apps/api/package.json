{
  "name": "@agent-casino/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "deploy:staging": "wrangler deploy --minify --env staging",
    "deploy:production": "wrangler deploy --minify --env production",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply agent-casino --local",
    "db:migrate:staging": "wrangler d1 migrations apply agent-casino-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply agent-casino-prod --remote --env production"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
