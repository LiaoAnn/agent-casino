{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agent-casino-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    // The watch page's URL carries the owner's watch token in its query
    // string: keep it out of request logs. Inherited by every environment.
    "redact_query_string": true,
  },
  // The api Worker, which the server functions of src/data.ts read from.
  "services": [{ "binding": "API", "service": "agent-casino-api" }],
  // Deployed environments (docs/deploy.md), chosen at build time with
  // CLOUDFLARE_ENV. Each binds the api Worker of the same environment.
  "env": {
    "staging": {
      "name": "agent-casino-web-staging",
      "services": [{ "binding": "API", "service": "agent-casino-api-staging" }],
    },
    "production": {
      "name": "agent-casino-web-production",
      "workers_dev": false,
      // Custom Domain: Cloudflare creates the DNS record and certificate.
      "routes": [{ "pattern": "casino.liaoann.net", "custom_domain": true }],
      "services": [
        { "binding": "API", "service": "agent-casino-api-production" },
      ],
    },
  },
}
