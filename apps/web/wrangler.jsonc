{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agent-casino-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // The api Worker, which the server functions of src/data.ts read from.
  "services": [{ "binding": "API", "service": "agent-casino-api" }],
  // Deployed environments (docs/deploy.md), chosen at build time with
  // CLOUDFLARE_ENV. Each binds the api Worker of the same environment.
  "env": {
    "staging": {
      "name": "agent-casino-web-staging",
      "services": [{ "binding": "API", "service": "agent-casino-api-staging" }],
    },
  },
}
