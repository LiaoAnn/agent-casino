{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agent-casino-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // The api Worker, which the server functions of src/data.ts read from.
  "services": [{ "binding": "API", "service": "agent-casino-api" }],
}
